---
interface Props {
  type: 'note' | 'warning' | 'tip';
}

const { type } = Astro.props;

// Complete class names so the Tailwind scan finds them.
const styles = {
  note: { label: 'Note', border: 'border-post', text: 'text-post' },
  warning: { label: 'Warning', border: 'border-photo', text: 'text-photo' },
  tip: { label: 'Tip', border: 'border-til', text: 'text-til' },
} as const;
const { label, border, text } = styles[type];
---

<div
  role="note"
  data-callout={type}
  aria-label={label}
  class:list={['my-6 rounded-r-lg border-l-4 bg-surface px-4 py-3 text-text', border]}
>
  <p class:list={['mt-0 mb-1 font-mono text-[11px] uppercase tracking-wider', text]}>{label}</p>
  <div class="[&>:first-child]:mt-0 [&>:last-child]:mb-0 [&_code]:text-head">
    <slot />
  </div>
</div>
