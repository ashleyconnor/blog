---
import type { EntryType } from '@ac/content';
import { entryTypes } from '../entry-types';

interface Props {
  type: EntryType;
  class?: string;
}

const { type, class: className } = Astro.props;
---

<svg
  viewBox="0 0 16 16"
  width="16"
  height="16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class:list={['shrink-0', entryTypes[type].text, className]}
>
  {
    type === 'post' && (
      <>
        <path d="M3 2.75A.75.75 0 0 1 3.75 2H9l4 4v7.25a.75.75 0 0 1-.75.75h-8.5a.75.75 0 0 1-.75-.75z" />
        <path d="M9 2v4h4M5.5 8.75h5M5.5 11.25h5" />
      </>
    )
  }
  {
    type === 'til' && (
      <>
        <path d="M6 12.25h4M6.75 14.25h2.5" />
        <path d="M8 1.75a4.25 4.25 0 0 0-2.4 7.76c.3.2.4.5.4.84v.4h4v-.4c0-.34.1-.64.4-.84A4.25 4.25 0 0 0 8 1.75z" />
      </>
    )
  }
  {
    type === 'photos' && (
      <>
        <rect x="2" y="3" width="12" height="10" rx="1.5" />
        <circle cx="5.75" cy="6.5" r="1" />
        <path d="m2.5 12 3.5-3.5 2.5 2.5 2-2 3 3" />
      </>
    )
  }
</svg>
