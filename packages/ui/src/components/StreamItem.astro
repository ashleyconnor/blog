---
import { Image } from 'astro:assets';
import { dayOfMonth, formatDate, type StreamItem } from '@ac/content';
import { entryTypes } from '../entry-types';
import TypeIcon from './TypeIcon.astro';

interface Props {
  item: StreamItem;
}

const { type, title, href, date, excerpt, minutes, advanced, draft, thumbs = [], extraCount = 0 } = Astro.props.item;

// Small mono labels: "Interactive" for advanced posts, "Draft" in preview builds.
const labels = [
  advanced && { text: 'Interactive', class: 'text-post' },
  draft && { text: 'Draft', class: 'text-photo' },
].filter((label) => !!label);
---

<li data-type={type} class="group relative grid grid-cols-[22px_1fr_auto] gap-3 py-4">
  <span class="mt-0.5 grid size-[22px] place-items-center rounded-md bg-surface">
    <TypeIcon type={type} class="size-3.5" />
  </span>
  <div class="min-w-0">
    <h3
      class:list={[
        'leading-[1.3] text-head',
        type === 'til' ? 'font-body text-[15.5px] font-medium' : 'font-heading text-lg font-medium',
      ]}
    >
      {/* The link's ::after covers the whole row, so the icon, thumbnails and day are clickable too.
          The type is only shown by the icon, so screen readers get it as a prefix. */}
      <a
        href={href}
        class="text-head decoration-muted underline-offset-4 group-hover:underline after:absolute after:inset-0 focus-visible:underline"
      >
        <span class="sr-only">{entryTypes[type].label}: </span>
        {title}{type === 'til' && <span aria-hidden="true" class="ml-1 text-til">↗</span>}
      </a>
    </h3>
    {
      (type === 'post' || labels.length > 0) && (
        <p class="mt-1 flex min-w-0 items-baseline gap-x-1 text-[13.5px] leading-normal text-muted">
          {labels.map((label) => (
            <>
              <span class:list={['mr-1 shrink-0 font-mono text-[11px] uppercase tracking-wider', label.class]}>
                {label.text}
              </span>{' '}
            </>
          ))}
          {/* One line: the excerpt is cut with an ellipsis by CSS only (the full text stays in the
              DOM for assistive tech), and the reading time never shrinks. The `{' '}` text nodes are
              invisible between flex items but keep words apart in the accessible text. */}
          {type === 'post' && (
            <>
              {excerpt && (
                <>
                  <span class="min-w-0 truncate">{excerpt}</span>{' '}
                </>
              )}
              <span class="shrink-0 whitespace-nowrap">
                {excerpt && '· '}
                {minutes} min
              </span>
            </>
          )}
        </p>
      )
    }
    {
      thumbs.length > 0 && (
        <div class="mt-2.5 flex items-center gap-1.5">
          {thumbs.map(({ src, alt }) => (
            <Image
              src={src}
              alt={alt}
              width={76}
              height={56}
              densities={[1, 2]}
              fit="cover"
              class="h-14 w-[76px] rounded-[5px] border border-line object-cover"
            />
          ))}
          {extraCount > 0 && <span class="ml-1 text-xs text-muted">+{extraCount}</span>}
        </div>
      )
    }
  </div>
  <time datetime={date.toISOString()} class="pt-[3px] font-mono text-xs text-muted">
    <span aria-hidden="true">{dayOfMonth(date)}</span><span class="sr-only">{formatDate(date)}</span>
  </time>
</li>
