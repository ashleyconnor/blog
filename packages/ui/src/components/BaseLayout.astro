---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Footer from './Footer.astro';
import SiteNav from './SiteNav.astro';

interface Props {
  title: string;
  description?: string;
  canonical: URL;
  /** Absolute URL, or a path resolved against `canonical`. */
  ogImage?: string | URL;
  noindex?: boolean;
  /** Shows the "Draft" banner. Drafts are always `noindex`. */
  draft?: boolean;
  /**
   * What the first screen is mostly set in, which decides the heading weight to preload: an article
   * opens with its bold title (Space Grotesk 700); a stream opens with row titles (Space Grotesk 500).
   */
  firstPaint?: 'article' | 'stream';
}

const SITE_DESCRIPTION = 'The idle thoughts of a rambling developer.';

const { title, canonical, ogImage, noindex = false, draft = false, firstPaint = 'article' } = Astro.props;
// `||`, not a default value, so an empty excerpt also falls back.
const description = Astro.props.description || SITE_DESCRIPTION;

const image = ogImage ? new URL(ogImage, canonical) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0f1629" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || draft) && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}

    {/* Preload only the two faces most of the first paint is set in: body text (Inter 400) and the
        heading weight of the first screen (see `firstPaint`). Every preload competes with the page
        for bandwidth: on a throttled mobile connection four preloads cost the first paint about
        0.4 s. The other weights load when used, like JetBrains Mono. */}
    <Font cssVariable="--font-space-grotesk" preload={[{ weight: firstPaint === 'stream' ? 500 : 700 }]} />
    <Font cssVariable="--font-inter" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-jetbrains-mono" />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-bg font-body text-text antialiased">
    {
      draft && (
        <div data-draft-banner role="status" class="border-b border-line bg-surface py-2 text-center text-sm text-photo">
          <strong class="font-mono font-medium uppercase tracking-wider">Draft</strong>
          <span class="text-muted"> · only shown in preview builds</span>
        </div>
      )
    }
    <div class="mx-auto w-full max-w-[680px] px-4 md:px-0">
      <slot name="nav"><SiteNav /></slot>
    </div>
    <main class="mx-auto w-full max-w-[680px] flex-1 px-4 md:px-0">
      <slot />
    </main>
    <div class="mx-auto w-full max-w-[680px] px-4 md:px-0">
      <Footer />
    </div>
  </body>
</html>
