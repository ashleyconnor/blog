---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Let the figure spread past the reading column (up to 1100px). */
  wide?: boolean;
}

const { src, alt, caption, wide = false } = Astro.props;

const widths = wide ? [480, 720, 1100] : [480, 720];
const sizes = wide ? '(min-width: 1132px) 1100px, calc(100vw - 2rem)' : '(min-width: 768px) 680px, 100vw';
---

<figure class:list={['my-8', { breakout: wide }]}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={widths}
    sizes={sizes}
    class="h-auto w-full rounded-lg border border-line"
  />
  {caption && <figcaption class="mt-2 text-sm text-muted">{caption}</figcaption>}
</figure>
