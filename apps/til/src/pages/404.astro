---
import BaseLayout from '@ac/ui/components/BaseLayout.astro';
import TilNav from '../components/TilNav.astro';
import { BLOG_ORIGIN, TIL_DESCRIPTION } from '../site';
---

<BaseLayout title="Page not found" description={TIL_DESCRIPTION} canonical={new URL('/404', Astro.site)} noindex>
  <TilNav slot="nav" />
  <section class="py-16">
    <p class="font-mono text-xs tracking-wider text-til uppercase">404</p>
    <h1 class="mt-3 mb-4 font-heading text-3xl leading-[1.15] font-bold text-head md:text-4xl">Page not found</h1>
    <p class="text-text">
      There's no TIL here. Try the <a href="/" class="text-til underline underline-offset-4 hover:text-head"
        >list of everything I've learned</a
      >, or head back to the <a
        href={`${BLOG_ORIGIN}/`}
        class="text-til underline underline-offset-4 hover:text-head">blog</a
      >.
    </p>
  </section>
</BaseLayout>
