---
import BaseLayout from '@ac/ui/components/BaseLayout.astro';
import StreamList from '@ac/ui/components/StreamList.astro';
import PageHeader from '../../components/PageHeader.astro';
import { publicStream } from '../../lib/stream';

const galleries = (await publicStream()).filter((item) => item.type === 'photos');
---

<BaseLayout firstPaint="stream" title="Photos · Ashley Connor" canonical={new URL('/photos/', Astro.site)}>
  <PageHeader title="Photos" />
  {galleries.length > 0 ? <StreamList items={galleries} /> : <p class="mt-6 text-muted">No photo galleries yet.</p>}
</BaseLayout>
