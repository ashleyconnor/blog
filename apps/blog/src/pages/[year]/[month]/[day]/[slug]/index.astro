---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import { formatDate, postParams, postPath, readingMinutes, showDrafts, stripMarkdown } from '@ac/content';
import BaseLayout from '@ac/ui/components/BaseLayout.astro';
import Prose from '@ac/ui/components/Prose.astro';
import Toc from '@ac/ui/components/Toc.astro';
import TypePill from '@ac/ui/components/TypePill.astro';

// Unlisted posts are built (reachable by URL); drafts only when previewing them. The URL date is
// the Los Angeles calendar date (see `postParams`).
export const getStaticPaths = (async () => {
  const drafts = showDrafts();
  const posts = await getCollection('posts', ({ data }) => drafts || !data.draft);
  return posts.map((post) => ({ params: postParams(post), props: { post } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props;
const { title, date, updated, tags, excerpt, draft } = post.data;
const { Content, headings } = await render(post);
const minutes = readingMinutes(post.body ?? '');
---

<BaseLayout
  title={title}
  description={excerpt && stripMarkdown(excerpt)}
  canonical={new URL(postPath(post), Astro.site)}
  draft={draft}
>
  <article class="py-10">
    <header class="mb-8">
      <TypePill type="post" />
      <h1 class="mt-3 mb-2 font-heading text-3xl leading-[1.15] font-bold text-head md:text-4xl">{title}</h1>
      <p class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs text-muted">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
        {
          updated && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
              </span>
            </>
          )
        }
        {
          tags.map((tag) => (
            <>
              <span aria-hidden="true">·</span>
              <a href={`/tags/${tag}/`} class="text-muted underline-offset-4 hover:text-head hover:underline">
                #{tag}
              </a>
            </>
          ))
        }
      </p>
    </header>
    <div class="relative">
      <Toc headings={headings} />
      <Prose><Content /></Prose>
    </div>
  </article>
</BaseLayout>
