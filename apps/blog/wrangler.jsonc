// A static-assets-only Worker: no script and no bindings. Cloudflare serves `dist/` and applies its
// `_redirects` and `_headers`. The custom domain below makes Cloudflare create its DNS record; the
// hostname must have no existing CNAME (see docs/cutover.md).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "blog",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "www.ashleyconnor.co.uk", "custom_domain": true }],
  // `wrangler preview` (PR previews) requires this block. Empty: a preview has no bindings to override.
  "previews": {},
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
