{
  "name": "ashleyconnor-sites",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": { "node": ">=22.23.4" },
  "scripts": {
    "build": "pnpm -r --filter './apps/*' build",
    "test": "vitest run",
    "check": "pnpm -r --filter './apps/*' check",
    "lighthouse": "LIGHTHOUSE_PRESET=desktop lhci autorun && LIGHTHOUSE_PRESET=mobile lhci autorun",
    "dev:blog": "pnpm --filter blog dev",
    "dev:til": "pnpm --filter til dev --port 4322",
    "preview:blog": "wrangler dev --local --config apps/blog/wrangler.jsonc --port 8787",
    "preview:til": "wrangler dev --local --config apps/til/wrangler.jsonc --port 8788",
    "new": "node --experimental-strip-types scripts/new.ts",
    "review:check": "node --experimental-strip-types scripts/review-checks.ts"
  },
  "devDependencies": {
    "@ac/ui": "workspace:*",
    "@lhci/cli": "0.15.1",
    "execa": "^9.6.0",
    "exifr": "7.1.3",
    "playwright": "1.64.1",
    "sharp": "0.35.5",
    "vitest": "5.0.5",
    "wrangler": "4.149.0",
    "yaml": "2.9.1"
  }
}
